# Production. Copy to .env.production, fill in every value, and keep it off git.
# Generate each secret with:
#   openssl rand -base64 48 | tr -d '/+=\n'

POSTGRES_USER=booking
POSTGRES_PASSWORD=
POSTGRES_DB=booking

# PostgREST logs in as this role.
AUTHENTICATOR_PASSWORD=

# Signs and verifies agent sessions. At least 32 characters. Changing it logs every agent out.
PGRST_JWT_SECRET=

# Public hostnames. Point DNS for both at this server; Caddy gets the certificates.
API_HOST=api.example.com
# Frontend hostname when Docker serves it. Leave empty when Vercel serves the frontend.
APP_HOST=app.example.com

# The URL the browser calls. The frontend image reads it at container start.
API_URL=https://api.example.com

# The frontend origin: https://app.example.com, or the Vercel production domain.
# Comma-separate several. Leaving it empty allows every origin.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Caddyfile serves the API and the frontend. Caddyfile.api serves only the API (Vercel mode).
CADDYFILE=Caddyfile
