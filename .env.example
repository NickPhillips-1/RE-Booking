# Local development. Copy to .env: cp .env.example .env
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking-dev-password
POSTGRES_DB=booking

# PostgREST logs in as this role.
AUTHENTICATOR_PASSWORD=authenticator-dev-password

# Signs agent sessions in api.login and verifies them in PostgREST. At least 32 characters.
PGRST_JWT_SECRET=dev-only-jwt-secret-0123456789abcdef

# The Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Password for the seeded agent jane@example.com (booking page /book/jane).
SEED_AGENT_PASSWORD=jane-dev-password

# Password for the seeded guest guest@example.com.
SEED_GUEST_PASSWORD=guest-dev-password
